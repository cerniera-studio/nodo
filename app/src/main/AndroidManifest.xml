<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Knots on their minute: granted once from Settings (Alarms & reminders). Without it, Android delivers them a little late -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The widget's glass finishes (Vetro, Cristallo), as in Fold Widgets: since Android 13 the
         wallpaper image is only readable with all-files access. Asked for in settings, never assumed -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Fluido: knots that wait for home. Nodo knows home by its Wi-Fi, and Android shows a Wi-Fi
         network's name only to apps with location permission: asked for when home is set -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- "Allow all the time": Nodo reads the Wi-Fi's name when Wi-Fi connects while it's closed -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Who may read the knot that matters most (its words): the family's apps (Momento in Fold Widgets) -->
    <permission
        android:name="com.cerniera.nodo.permission.NEXT"
        android:label="See the knot that matters most in Nodo"
        android:protectionLevel="normal" />

    <!-- Fold Widgets' look (finish, corners, glass images), which the widget follows -->
    <queries>
        <!-- As a package, not a provider: the Kit already lists Cielo's provider, and two provider
             entries here collide when the manifests merge -->
        <package android:name="com.fergusonconsultancy.foldwidgets" />
        <package android:name="com.cerniera.settimana" />
        <!-- "When I open Spotify": finding the app by the name typed -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".NodoApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.App"
        android:resizeableActivity="true">

        <!-- Folding and turning are handled in place: the thread lays itself out again -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustPan"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|uiMode|density|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver android:name=".ReminderReceiver" android:exported="false" />

        <!-- Fluido: moments that untie knots (Wi-Fi reaching home; Fold Taskbar saying an app opened) -->
        <receiver android:name=".CueReceiver" android:exported="true">
            <intent-filter><action android:name="com.cerniera.nodo.CUE" /></intent-filter>
        </receiver>
        <!-- Which apps knots are waiting for (packages only, never the words), for Fold Taskbar -->
        <provider
            android:name=".CueProvider"
            android:authorities="com.cerniera.nodo.cues"
            android:exported="true">
            <!-- The next knot carries words, so it needs the family's permission; the app list doesn't -->
            <path-permission android:path="/next" android:readPermission="com.cerniera.nodo.permission.NEXT" />
            <!-- Settimana's margins: the week's knots, words included, so the same permission -->
            <path-permission android:path="/week" android:readPermission="com.cerniera.nodo.permission.NEXT" />
        </provider>
        <receiver android:name=".ActionReceiver" android:exported="false" />
        <!-- The thread on the home screen -->
        <receiver android:name=".NodoWidget" android:exported="true" android:label="Nodo · Thread">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/nodo_widget" />
        </receiver>

        <!-- Fold Widgets tells Nodo when its look, or the wallpaper, changed -->
        <receiver android:name=".LookReceiver" android:exported="true">
            <intent-filter>
                <action android:name="com.cerniera.LOOK_CHANGED" />
            </intent-filter>
        </receiver>

        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
